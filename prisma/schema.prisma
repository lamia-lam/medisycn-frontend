generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  PHARMACY
  DIAGNOSTIC
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id        Int    @id @default(autoincrement())
  name      String
  email     String? @unique
  phone String? @unique
  password  String?
  isOffline Boolean @default(false)
  role      Role
  status    AccountStatus @default(PENDING)
  createdAt DateTime @default(now())

  doctor     Doctor?
  patient    Patient?
  pharmacy   Pharmacy?
  diagnostic Diagnostic?
}

model Pharmacy {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  license   String?
  avatar    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Diagnostic {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  license   String?
  avatar    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Doctor {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique

  specialization String?
  department     String?
  designation    String?
  qualifications String?
  license        String?
  avatar         String?
  availability   Json?

  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  patients       DoctorPatient[]
  prescriptions  Prescription[]
  appointments   Appointment[]
}

model Patient {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  age           Int?
  gender        String?
  dateOfBirth   DateTime?
  bloodGroup    String?
  condition     String?
  address       String?
  status        String   @default("Active")
  createdAt     DateTime @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctors       DoctorPatient[]
  prescriptions Prescription[]
  appointments  Appointment[]
  histories     MedicalHistory[]
  reports       DiagnosticReport[]  // ← ADD
  dispenseRecords DispenseRecord[]
}

model DoctorPatient {
  id        Int      @id @default(autoincrement())

  doctorId  Int
  patientId Int

  createdAt DateTime @default(now())
  lastVisit DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientId])
}

model Appointment {
  id          Int      @id @default(autoincrement())
  doctorId    Int
  patientId   Int
  date        DateTime
  type        String?
  notes       String?
  status      String   @default("Pending")
  serialNo    Int?
  createdAt   DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Prescription {
  id            Int      @id @default(autoincrement())
  doctorId      Int
  patientId     Int
  diagnosis     String
  symptoms      String?
  medicines     Json
  tests         Json?    // ← ADD (diagnostic tests the doctor orders)
  notes         String?
  createdAt     DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dispenseRecords DispenseRecord[]
}

model DiagnosticReport {
  id             Int      @id @default(autoincrement())
  patientId      Int
  prescriptionId Int?
  testName       String
  testIndex      Int      @default(0)
  findings       String   @default("")
  reportUrl      String?
  status         String   @default("In_Progress")
  createdAt      DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}


model MedicalHistory {
  id          Int      @id @default(autoincrement())

  patientId   Int

  title       String
  description String
  type        String

  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Medicine {
  id                Int      @id @default(autoincrement())
  name              String
  genericName       String
  category          String
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(50)
  expiryDate        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DispenseRecord {
  id                 Int      @id @default(autoincrement())
  prescriptionId     Int
  patientId          Int
  medicinesDispensed Int
  status             String
  dispensedAt        DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
}