generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  PATIENT
  PHARMACY
  DIAGNOSTIC
}

model User {
  id        Int    @id @default(autoincrement())
  name      String
  email     String @unique
  phone     String?
  password  String
  role      Role
  createdAt DateTime @default(now())
}